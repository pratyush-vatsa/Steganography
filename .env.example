# Copy this file to .env for local dev (and load it, e.g. with python-dotenv
# or `export $(cat .env | xargs)`), or set these as real environment
# variables / systemd unit vars / hosting-provider env vars in production.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Parent directory for per-request scratch files.
# Defaults to the OS temp dir if unset.
STEGO_BASE_DIR=/tmp/stego-data

# Optional. Port gunicorn/the dev server binds to. Defaults to 5000.
PORT=5000

# Optional. Max raw upload size in MB. Defaults to 64.
MAX_UPLOAD_MB=64

# Optional. Max cover image resolution in megapixels. Defaults to 30
# (comfortable on a machine with several GB of RAM). Measured memory model:
# peak RSS during hide/extract is roughly 63MB + 78MB per megapixel (see
# docs/DEPLOYMENT_NOTES.md for how this was measured). Size this to your
# actual host: safe_MP = (available_RAM_MB - 200) / 78. On a 1GB VM with
# --workers 1, that's roughly MAX_IMAGE_MEGAPIXELS=4-6; on a 512MB host,
# lower still (2-3).
MAX_IMAGE_MEGAPIXELS=30
